{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/lib/gigxomi/*": [
        "./archive_legacy/_quarantine_gigxomi/*"
      ],
      "@/app/api/sales/*": [
        "./src/app/api/_quarantine/sales/*",
        "./src/app/api/sales/*"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-prod/types/**/*.ts",
    ".next-prod/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "archive_legacy",
    "archive_legacy/**",
    "src/lib/_quarantine_gigxomi/**",
    "src/app/api/_quarantine/**",
    "src/components/chat/chat-workspace.tsx",
    "src/components/sales/sales-dashboard.tsx",
    "mobile-app",
    "mobile-app/**",
    "apps/mobile",
    "apps/mobile/**",
    "apps/crm-mobile",
    "apps/crm-mobile/**",
    "work",
    "work/**"
  ]
}
