DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/gigxomi?schema=public
SESSION_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_APP_URL=https://closer.gigxomi.com

# Required only for the first owner bootstrap or an intentional password rotation.
# Remove it from the runtime environment after the owner can sign in.
GXCLOSERS_SUPER_ADMIN_BOOTSTRAP_PASSWORD=
GXCLOSERS_SUPER_ADMIN_PHONE=

# Signed Gigxomi -> GXClosers Customer 360 ingestion.
GXCLOSERS_JOURNEY_SIGNING_SECRET=

# ==============================================================================
# Meta Application & WhatsApp Marketing Configuration
# ==============================================================================

# Meta Application
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Supported legacy aliases for Meta App
META_WHATSAPP_APP_ID=
META_WHATSAPP_CONFIG_ID=
GIGXOMI_META_APP_SECRET=

# WhatsApp Bootstrap Configuration (Used only for local testing / bootstrap)
# Multi-tenant production feature uses encrypted token stored in WhatsAppChannel DB record.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_VERIFY_TOKEN=

# WhatsApp Token Encryption (AES-256-GCM)
# Required in production; will fail safely if omitted in production.
# In local development, falls back safely to SESSION_SECRET.
WHATSAPP_TOKEN_ENCRYPTION_SECRET=

# WhatsApp Marketing Operational Mode: 'mock' | 'live'
# Set to 'mock' for local development & dry-run validation (no real WhatsApp messages sent).
WHATSAPP_MARKETING_MODE=mock

# ==============================================================================
# Google Sheets Import OAuth
# ==============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://closer.gigxomi.com/api/whatsapp-marketing/contacts/import/oauth-callback

# ==============================================================================
# Meta Conversions API (CAPI) — Kept strictly separate from WhatsApp Marketing
# ==============================================================================
META_CAPI_ACCESS_TOKEN=
META_CAPI_DATASET_ID=
META_CAPI_WHATSAPP_ACCESS_TOKEN=
META_CAPI_WHATSAPP_DATASET_ID=
META_CAPI_WHATSAPP_PHONE_NUMBER_ID=

# ==============================================================================
# Other Integrations
# ==============================================================================
INSTAGRAM_APP_SECRET=
INSTAGRAM_OAUTH_CLIENT_ID=
INSTAGRAM_OAUTH_CLIENT_SECRET=
INSTAGRAM_PUBLIC_APP_URL=https://closer.gigxomi.com
WEBINAR_GG_API_TOKEN=
WEBINAR_GG_WEBINAR_ID=
FIREBASE_SERVICE_ACCOUNT_FILE=

# Live app.gigxomi.com customer registration and integration status proxy.
GIGXOMI_REGISTRATION_STATUS_URL=https://app.gigxomi.com/api/internal/registration-status
REGISTRATION_STATUS_API_KEY=
