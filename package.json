{
  "name": "aicloser",
  "version": "1.0.0",
  "private": true,
  "description": "AIcloser — Dedicated SIM-based AI Sales & Telecalling CRM.",
  "scripts": {
    "dev": "next dev --webpack -p 3010",
    "build": "next build --webpack",
    "start": "node node_modules/next/dist/bin/next start -p 3010",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs",
    "mobile:build": "cd apps/crm-mobile && gradlew.bat assembleDebug",
    "mobile:test": "cd apps/crm-mobile && gradlew.bat testDebugUnitTest",
    "mobile:lint": "cd apps/crm-mobile && gradlew.bat lintDebug",
    "mobile:bundle": "cd apps/crm-mobile && gradlew.bat bundleRelease",
    "postinstall": "node scripts/postinstall.js",
    "db:generate": "prisma generate",
    "db:verify": "node scripts/verify-db.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@types/qrcode": "^1.5.6",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "@xyflow/react": "^12.10.2",
    "dotenv": "^17.4.2",
    "emoji-picker-react": "^4.19.1",
    "firebase": "^12.12.1",
    "firebase-admin": "^13.8.0",
    "lamejs": "^1.2.1",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "pg": "^8.20.0",
    "pino": "^10.4.0",
    "prisma": "^7.6.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "license": "UNLICENSED"
}
